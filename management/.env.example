# Production uses Cloudflare Worker variables/secrets and DB/R2/Queue bindings.
# This file contains names and safe defaults only. Do not save credential values
# to tracked files. Production is not ready while any required binding is absent.
ENVIRONMENT=production
PLATFORM=cloudflare
ADMIN_ORIGIN=https://admin.mourn.top
BLOG_ORIGIN=https://blog.mourn.top
MEDIA_ORIGIN=https://media.mourn.top
GITHUB_REPOSITORY=Nocticur/Firefly-hyde
GITHUB_BRANCH=main
BLOG_WORKER_NAME=firefly-hyde
ADMIN_GITHUB_USER_ID=285582250
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
# Exact name and numeric App ID observed on this repository's Workers Builds
# GitHub Check. Required for failure detection; do not guess or reuse old CI.
GITHUB_BUILD_CHECK_NAME=Workers Builds: firefly-hyde
# Observed official cloudflare-workers-and-pages GitHub App ID.
GITHUB_BUILD_CHECK_APP_ID=85455
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
IP_HASH_SECRET=
RESEND_API_KEY=
MAIL_FROM=
# Optional: cache-purge permission and this zone are needed only for clear-cache.
CLOUDFLARE_ZONE_ID=
# Optional: comma-separated exact HTTPS hostnames for external media imports.
# No URL, wildcard, redirect or private IP/DNS address is accepted.
MEDIA_IMPORT_HOSTS=
# Bindings (configured in wrangler, not string credentials):
# DB, PRIVATE_MEDIA, PUBLIC_MEDIA, TASKS, ASSETS
# Local development only: PORT, ADMIN_ORIGIN, BLOG_ORIGIN, MEDIA_ORIGIN,
# LOCAL_DB_PATH, LOCAL_MEDIA_PATH, DEV_AUTH_SECRET.
# pnpm dev creates .local/development-key with restricted permissions if needed.
