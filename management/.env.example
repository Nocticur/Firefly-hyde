# Current production: root wrangler.jsonc, one Workers Free Worker + D1.
# Runtime Secrets go in Cloudflare firefly-hyde Settings, not Git or Builds only.
ENVIRONMENT=production
PLATFORM=cloudflare
AUTH_MODE=password
FREE_PLAN=1
MAIL_MODE=disabled
ADMIN_ORIGIN=https://blog.mourn.top
ADMIN_PATH=/admin/
BLOG_ORIGIN=https://blog.mourn.top
MEDIA_ORIGIN=https://blog.mourn.top/api/public/media/
ADMIN_GITHUB_USER_ID=285582250
GITHUB_REPOSITORY=Nocticur/Firefly-hyde
GITHUB_BRANCH=main
BLOG_WORKER_NAME=firefly-hyde
GITHUB_BUILD_CHECK_NAME=Workers Builds: firefly-hyde
GITHUB_BUILD_CHECK_APP_ID=85455
# Secrets required for password login; password length 12-256 characters.
ADMIN_PASSWORD=
IP_HASH_SECRET=
# Required only for publishing and strict production verification.
GITHUB_PUBLISH_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional public comments/friend requests: free Turnstile keys.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
MEDIA_IMPORT_HOSTS=
# Optional GitHub App alternative to GITHUB_PUBLISH_TOKEN (free, no OAuth login).
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
# DB is an actual D1 binding; ASSETS and VERSION are platform bindings.
# No R2, Queue, OAuth login or email credentials required in the free plan.
# Local development only: PORT, LOCAL_DB_PATH, DEV_AUTH_SECRET. To test the
# password form set AUTH_MODE=password, local ADMIN_PASSWORD and IP_HASH_SECRET.
