// Optional isolated management development/preview configuration.
// The current production entry is the repository-root wrangler.jsonc.
// Keep Workers Free: no R2, Queue, email billing or automatic production Cron.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nocticur-firefly-hyde-admin-development",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "preview_urls": false,
  "assets": {
    "directory": "./ui/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "PLATFORM": "cloudflare",
    "ENVIRONMENT": "development",
    "ADMIN_ORIGIN": "http://localhost:8787",
    "BLOG_ORIGIN": "http://localhost:4321",
    "GITHUB_REPOSITORY": "Nocticur/Firefly-hyde",
    "GITHUB_BRANCH": "main",
    "BLOG_WORKER_NAME": "firefly-hyde",
    "AUTH_MODE": "password",
    "FREE_PLAN": "1",
    "MAIL_MODE": "disabled"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nocticur-admin-development",
      "migrations_dir": "migrations",
      "remote": false
    }
  ],
  "r2_buckets": [],
  "triggers": {
    "crons": []
  },
  "env": {
    "preview": {
      "name": "nocticur-firefly-hyde-admin-preview",
      "preview_urls": false,
      "vars": {
        "PLATFORM": "cloudflare",
        "ENVIRONMENT": "preview",
        "ADMIN_GITHUB_USER_ID": "285582250",
        "ADMIN_ORIGIN": "https://admin-preview.mourn.top",
        "BLOG_ORIGIN": "https://blog-preview.mourn.top",
        "MEDIA_ORIGIN": "https://media-preview.mourn.top",
        "GITHUB_REPOSITORY": "Nocticur/Firefly-hyde",
        "GITHUB_BRANCH": "preview",
        "BLOG_WORKER_NAME": "nocticur-firefly-hyde-blog-preview",
        "AUTH_MODE": "password",
        "FREE_PLAN": "1",
        "MAIL_MODE": "disabled"
      },
      "d1_databases": [],
      "r2_buckets": [],
      "triggers": {
        "crons": []
      },
      "queues": {
        "producers": [],
        "consumers": []
      }
    },
    "production": {
      "name": "nocticur-firefly-hyde-admin",
      "preview_urls": false,
      "vars": {
        "PLATFORM": "cloudflare",
        "ENVIRONMENT": "production",
        "ADMIN_GITHUB_USER_ID": "285582250",
        "ADMIN_ORIGIN": "https://admin.mourn.top",
        "BLOG_ORIGIN": "https://blog.mourn.top",
        "MEDIA_ORIGIN": "https://media.mourn.top",
        "GITHUB_REPOSITORY": "Nocticur/Firefly-hyde",
        "GITHUB_BRANCH": "main",
        "BLOG_WORKER_NAME": "firefly-hyde",
        "GITHUB_BUILD_CHECK_NAME": "Workers Builds: firefly-hyde",
        "GITHUB_BUILD_CHECK_APP_ID": "85455",
        "BACKUP_PREFIX": "backups/",
        "AUTH_MODE": "password",
        "FREE_PLAN": "1",
        "MAIL_MODE": "disabled"
      },
      "d1_databases": [],
      "r2_buckets": [],
      "queues": {
        "producers": [],
        "consumers": []
      },
      "triggers": {
        "crons": []
      }
    }
  }
}
