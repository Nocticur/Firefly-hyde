{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "firefly-hyde",
	"main": "workers/blog.js",
	"compatibility_date": "2026-07-01",
	"version_metadata": { "binding": "VERSION" },
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"run_worker_first": true,
		"not_found_handling": "404-page"
	},
	// The existing blog can deploy before the separate administration Worker exists.
	// Public interaction routes return 503 until the production binding is enabled.
	"services": [],
	"env": {
		"production": {
			"name": "firefly-hyde",
			"version_metadata": { "binding": "VERSION" },
			"services": [
				{
					"binding": "ADMIN",
					"service": "nocticur-firefly-hyde-admin"
				}
			]
		}
	}
}
