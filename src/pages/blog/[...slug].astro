---
import { getSortedPosts } from "@utils/content-utils";
import { getPostUrlBySlug, removeFileExtension } from "@utils/url-utils";

export async function getStaticPaths() {
	const entries = await getSortedPosts();
	return entries.map((entry) => ({
		params: { slug: removeFileExtension(entry.id) },
		props: { destination: getPostUrlBySlug(entry.id) },
	}));
}

// Astro 生成本地预览的跳转页；Cloudflare Worker/_redirects 提供真正的 HTTP 301。
return Astro.redirect(encodeURI(Astro.props.destination), 301);
---
