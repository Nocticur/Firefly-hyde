---
import { Icon } from "astro-icon/components";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
---

<MainGridLayout title="远程笔记" description="查看远程笔记详情">
	<div class="remote-entry-container">
		<div class="entry-header">
			<a href="/" class="back-btn">
				<Icon name="material-symbols:arrow-back" />
				返回首页
			</a>
		</div>
		<div class="entry-content">
			<div class="error-state"><p>暂无公开笔记。</p></div>
		</div>
	</div>
</MainGridLayout>

<style>
	.remote-entry-container {
		max-width: 800px;
		margin: 0 auto;
		padding: 20px;
	}

	.entry-header {
		margin-bottom: 24px;
	}

	.back-btn {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 10px 20px;
		background: var(--btn-regular-bg);
		color: var(--text-color);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		cursor: pointer;
		font-size: 0.875rem;
	}

	.back-btn:hover {
		background: var(--primary);
		color: white;
		border-color: var(--primary);
	}

	.entry-content {
		background: var(--card-bg);
		border: 1px solid var(--border);
		border-radius: var(--radius-large);
		padding: 24px;
	}

	.loading-state, .error-state {
		text-align: center;
		padding: 40px;
		color: var(--content-meta);
	}

	.loading-icon {
		font-size: 3rem;
		margin-bottom: 16px;
		animation: spin 1s linear infinite;
	}

	@keyframes spin {
		from { transform: rotate(0deg); }
		to { transform: rotate(360deg); }
	}

	.entry-article {
		max-width: 100%;
	}

	.entry-title {
		font-size: 1.75rem;
		font-weight: 600;
		margin-bottom: 16px;
	}

	.entry-meta {
		display: flex;
		gap: 16px;
		margin-bottom: 24px;
		font-size: 0.875rem;
		color: var(--content-meta);
	}

	.entry-body {
		line-height: 1.8;
	}

	.entry-body h1, .entry-body h2, .entry-body h3 {
		margin-top: 24px;
		margin-bottom: 12px;
	}

	.entry-body h1 { font-size: 1.5rem; }
	.entry-body h2 { font-size: 1.25rem; }
	.entry-body h3 { font-size: 1.125rem; }

	.entry-body p {
		margin-bottom: 16px;
	}

	.entry-body ul, .entry-body ol {
		padding-left: 24px;
		margin-bottom: 16px;
	}

	.entry-body blockquote {
		border-left: 4px solid var(--primary);
		padding-left: 16px;
		margin: 16px 0;
		color: var(--content-meta);
		background: var(--bg);
		padding: 12px 16px;
		border-radius: 0 var(--radius) var(--radius) 0;
	}

	.entry-body code {
		background: var(--bg);
		padding: 2px 6px;
		border-radius: 4px;
		font-family: monospace;
	}

	.entry-body pre {
		background: var(--bg);
		padding: 16px;
		border-radius: var(--radius);
		overflow-x: auto;
		margin: 16px 0;
	}

	.entry-body pre code {
		background: transparent;
		padding: 0;
	}

	.entry-body img {
		max-width: 100%;
		border-radius: var(--radius);
		margin: 16px 0;
	}

	.entry-body hr {
		border: none;
		border-top: 1px solid var(--border);
		margin: 24px 0;
	}
</style>