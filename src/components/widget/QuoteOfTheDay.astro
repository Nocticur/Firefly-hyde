---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import WidgetLayout from "@/components/common/WidgetLayout.astro";

// 从 content/ziyuan/quote.md 读取名言数据，作为 API 请求失败时的降级兜底
const ziyuanEntries = await getCollection("ziyuan");
const quoteEntry = ziyuanEntries.find((e) => e.id === "quote");
const quoteData = quoteEntry?.data as any;
const quotes = quoteData?.quotes || [];

interface Props {
	class?: string;
	style?: string;
}

const { class: className, style } = Astro.props;

// 使用日期作为随机种子，确保同一天显示相同的兜底名言（SSR 渲染，无 JS 环境也有内容）
const today = new Date();
const dateStr = today.toISOString().split("T")[0];
const seed = dateStr
	.split("")
	.reduce((acc, char) => acc + char.charCodeAt(0), 0);
const randomIndex = quotes.length > 0 ? seed % quotes.length : 0;
const fallbackQuote = quotes[randomIndex] || { text: "暂无名言", author: "" };
---

<WidgetLayout name="✨ 今日一言" id="quote-of-the-day" class={className} style={style}>
	<button
		slot="title-icon"
		type="button"
		class="quote-refresh-btn"
		title="换一句"
		aria-label="刷新今日一言"
	>
		<Icon name="material-symbols:refresh-rounded" class="text-[1.25rem]" aria-hidden="true" />
	</button>
	<div class="quote-content" data-state="loading">
		<blockquote class="quote-text">
			<span class="quote-mark">"</span><span class="quote-body">{fallbackQuote.text}</span><span class="quote-mark">"</span>
		</blockquote>
		<cite class="quote-author">—— {fallbackQuote.author}</cite>
		<p class="quote-status" role="status" aria-live="polite"></p>
	</div>
</WidgetLayout>

<script>
	// 一言 API 返回数据模型（https://developer.hitokoto.cn/）
	interface HitokotoResponse {
		id: number;
		uuid: string;
		hitokoto: string;
		type: string;
		from: string;
		from_who: string | null;
		creator: string;
		creator_uid: number;
		reviewer: number;
		commit_from: string;
		created_at: string;
		length: number;
	}

	type RequestState = "loading" | "success" | "error";

	/** 运行时数据格式校验，防止接口返回异常结构 */
	function isHitokotoResponse(data: unknown): data is HitokotoResponse {
		if (typeof data !== "object" || data === null) return false;
		const d = data as Record<string, unknown>;
		return (
			typeof d.hitokoto === "string" &&
			d.hitokoto.length > 0 &&
			(d.from === undefined || typeof d.from === "string") &&
			(d.from_who === null || d.from_who === undefined || typeof d.from_who === "string")
		);
	}

	/** 请求一言 API，带 5s 超时与格式校验 */
	async function fetchHitokoto(): Promise<HitokotoResponse> {
		const controller = new AbortController();
		const timer = setTimeout(() => controller.abort(), 5000);
		try {
			const response = await fetch("https://v1.hitokoto.cn/?max_length=30", {
				signal: controller.signal,
			});
			if (!response.ok) {
				throw new Error(`HTTP ${response.status}`);
			}
			const data: unknown = await response.json();
			if (!isHitokotoResponse(data)) {
				throw new Error("响应数据格式不符合预期");
			}
			return data;
		} finally {
			clearTimeout(timer);
		}
	}

	/** 组装署名：优先「作者《出处》」，仅有出处时「《出处》」，均无时「佚名」 */
	function formatAuthor(data: HitokotoResponse): string {
		const parts: string[] = [];
		if (data.from_who) parts.push(data.from_who);
		if (data.from) parts.push(`《${data.from}》`);
		return parts.length > 0 ? `—— ${parts.join("")}` : "—— 佚名";
	}

	function initQuote() {
		const root = document.getElementById("quote-of-the-day");
		// 防止 Swup 换页或重复触发时重复初始化
		if (!root || root.dataset.quoteInit === "1") return;
		root.dataset.quoteInit = "1";

		const content = root.querySelector<HTMLElement>(".quote-content");
		const bodyEl = root.querySelector<HTMLElement>(".quote-body");
		const authorEl = root.querySelector<HTMLElement>(".quote-author");
		const statusEl = root.querySelector<HTMLElement>(".quote-status");
		// 刷新按钮经 title-icon 插槽渲染在标题行，是 #quote-of-the-day 的兄弟节点，
		// 需向上扩大到整个 widget-layout 容器才能查到
		const widget = root.closest("widget-layout") ?? root;
		const refreshBtn = widget.querySelector<HTMLButtonElement>(".quote-refresh-btn");
		if (!content || !bodyEl || !authorEl || !statusEl) return;

		const setState = (state: RequestState, message = "") => {
			content.dataset.state = state;
			statusEl.textContent = message;
		};

		let loading = false;
		const load = () => {
			if (loading) return;
			loading = true;
			if (refreshBtn) {
				refreshBtn.classList.add("is-loading");
				refreshBtn.disabled = true;
			}
			setState("loading");
			fetchHitokoto()
				.then((data) => {
					bodyEl.textContent = data.hitokoto;
					authorEl.textContent = formatAuthor(data);
					setState("success");
				})
				.catch((error: unknown) => {
					// 请求失败：保留当前内容（首次为 SSR 本地兜底名言），仅提示状态
					console.warn("[今日一言] 获取失败:", error);
					setState("error", "一言服务暂时不可用，请稍后重试");
				})
				.finally(() => {
					loading = false;
					if (refreshBtn) {
						refreshBtn.classList.remove("is-loading");
						refreshBtn.disabled = false;
					}
				});
		};

		// 点击刷新按钮重新请求
		refreshBtn?.addEventListener("click", load);
		load();
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initQuote);
	} else {
		initQuote();
	}
	// Swup 页面切换后重新初始化（组件可能随容器重新渲染）
	document.addEventListener("astro:page-load", initQuote);
</script>

<style>
	/* 刷新按钮：右缘加 1rem 与内容区 cite 署名（px-4）右对齐 */
	.quote-refresh-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.75rem;
		height: 1.75rem;
		margin-right: 1rem;
		border-radius: 0.375rem;
		color: var(--content-meta);
		cursor: pointer;
		transition:
			color 0.2s ease,
			background-color 0.2s ease;
	}

	.quote-refresh-btn:hover {
		color: var(--primary);
		background-color: color-mix(in oklch, var(--primary) 10%, transparent);
	}

	.quote-refresh-btn:active {
		transform: scale(0.92);
	}

	.quote-refresh-btn:disabled {
		cursor: default;
		opacity: 0.6;
	}

	/* 仅请求中旋转，平时静止 */
	.quote-refresh-btn.is-loading :global(svg) {
		animation: quote-spin 1s linear infinite;
	}

	@keyframes quote-spin {
		to {
			transform: rotate(360deg);
		}
	}

	.quote-content {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding: 0.5rem 0;
	}

	.quote-text {
		position: relative;
		font-style: italic;
		font-size: 0.9rem;
		line-height: 1.6;
		padding: 0 0.5rem;
		margin: 0;
	}

	.quote-mark {
		font-size: 1.5rem;
		line-height: 0;
		vertical-align: middle;
		color: var(--primary);
		opacity: 0.6;
		font-family: Georgia, serif;
	}

	.quote-author {
		display: block;
		text-align: right;
		font-size: 0.75rem;
		color: var(--content-meta);
		font-style: normal;
		margin-top: 0.25rem;
	}

	/* 请求状态提示：仅 loading / error 时可见 */
	.quote-status {
		display: none;
		margin: 0;
		font-size: 0.7rem;
		color: var(--content-meta);
		text-align: right;
	}

	.quote-content[data-state="loading"] .quote-status,
	.quote-content[data-state="error"] .quote-status {
		display: block;
	}

	/* 加载中：正文半透明弱化，暗示内容待替换 */
	.quote-content[data-state="loading"] .quote-text,
	.quote-content[data-state="loading"] .quote-author {
		opacity: 0.45;
		transition: opacity 0.3s ease;
	}

	/* 深色模式优化 */
	:global(html.dark) .quote-text {
		color: #fff;
	}

	/* 悬停效果 */
	:global(.quote-content:hover .quote-text) {
		color: var(--primary);
		transition: color 0.2s ease;
	}
</style>
